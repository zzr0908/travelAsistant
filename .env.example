# 可直接运行，无模型密钥时支持手动规划。普通 API Key 与 Coding Key 分开。
ZHIPU_API_KEY=
CARD_API_KEY=
# 仅显式执行 npm run start:agent:dev 时使用，不用于生产或卡片提取。
ZHIPU_CODING_API_KEY=
HOST=127.0.0.1
PORT=4317
INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=4319
APP_INTERNAL_URL=http://127.0.0.1:4319
DATA_DIR=./data
AGENT_DATA_DIR=./data-agent
# 不填时在 DATA_DIR/config 自动生成服务凭据与首次设置凭据。
# TRAVEL_SERVICE_TOKEN_FILE=/absolute/path/service-token
# TRAVEL_CONFIG_DIR=/absolute/path/config
BROWSER_ENABLED=1
# BROWSER_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 云端经 HTTPS 反向代理部署时填写，并按实际代理配置 TRUST_PROXY。
PUBLIC_URL=
TRUST_PROXY=
# Docker 默认仅本机访问；需要外部访问时配置为 0.0.0.0 并设置 PUBLIC_URL。
BIND_HOST=127.0.0.1
