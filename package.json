{
  "name": "travel-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "A local travel workspace for planning together",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "tsx watch src/service/server/main.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/start-services.mjs",
    "check": "tsc --noEmit && node --check prototypes/italy-trip.js && node --check prototypes/assets/map-mock.js && npm run check:boundaries",
    "test:prototype": "node tests/prototype-check.cjs",
    "test": "tsx --test tests/*.test.ts && npm run test:prototype",
    "backup": "tsx src/storage/maintenance.ts backup",
    "restore": "tsx src/storage/maintenance.ts restore",
    "test:runtime": "npm run build && node scripts/verify-runtime.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "browser": "tsx src/agent/browser/main.ts",
    "browser:mcp": "node dist/server/agent/browser/main.js mcp",
    "test:browser": "tsx --test tests/browser*.test.ts",
    "test:browser:runtime": "npm run build && node scripts/verify-browser.mjs",
    "check:browser:sources": "node scripts/check-browser-sources.mjs",
    "harness:florence": "node scripts/run-harness-browser.mjs",
    "test:harness-report": "node --test tests/harness-report.test.mjs",
    "harness:prepare": "node scripts/prepare-harness-app.mjs --build",
    "test:agent": "tsx --test tests/agent*.test.ts",
    "start:agent:dev": "node scripts/start-agent.mjs --development",
    "test:agent:runtime": "npm run build && node scripts/verify-remote-persistence.mjs && node scripts/verify-agent-crash.mjs && node scripts/verify-agent.mjs",
    "dev:experience": "vite --config prototypes/experience/vite.config.ts",
    "build:experience": "tsc -p prototypes/experience/tsconfig.json && vite build --config prototypes/experience/vite.config.ts",
    "preview:experience": "node scripts/serve-experience.mjs",
    "start:app": "node dist/server/service/server/main.js",
    "start:agent": "node scripts/start-agent.mjs",
    "dev:agent": "tsx watch src/agent/runtime/main.ts",
    "test:execution": "tsx --test tests/execution*.test.ts",
    "build:app": "tsc -p tsconfig.app.json && vite build",
    "build:agent": "tsc -p tsconfig.agent.json",
    "setup": "node scripts/bootstrap.mjs",
    "install:local": "bash scripts/install.sh",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:services": "node scripts/verify-services.mjs && node scripts/verify-remote-persistence.mjs",
    "check:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "linkedom": "0.18.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "^12.11.1",
    "chrome-devtools-mcp": "1.8.0",
    "fastify": "^5.12.3",
    "lucide-react": "^1.41.0",
    "maplibre-gl": "6.8.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.4",
    "undici": "8.10.2",
    "zod": "^4.5.4"
  }
}
